# Datos generales de la aplicación
APP_NAME="Sistema - Trabajos de grado"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1
APP_URL_PREFIX=

# Dirección de los recursos
ASSET_URL=http://127.0.0.1

# Ruta del ejecutable de mysqldump
PATH_MYSQL_DUMP=

# Configuración de los logs
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Pesos "Proyectos de grado"
PESO_MAXIMO_PAGO=5
PESO_MAXIMO_PROPUESTA=8
PESO_MAXIMO_INFORME=10

# Pesos "Prácticas"
PESO_MAXIMO_ARCHIVOS=8
PESO_MAXIMO_HOJASVIDA=9

# Datos del programa
NOMBRE_PROGRAMA=
CORREO_SISTEMAS=
CORREO_COORDINACION=

# Días para la entrega de informes
DIAS_MINIMOS_INFORME=90
DIAS_MAXIMOS_INFORME=180

# Días para el recordatorio de revisión y envío de informes
DIAS_RECORDATORIO=4

# Días para la entrega de prácticas
PRACTICA_DIAS_MINIMO=90
PRACTICA_DIAS_MAXIMO=180

# Días para la prórroga de prácticas
PRACTICA_PRORROGA_DIAS=90
PRACTICA_GRACIA_ENVIO_FASE5=15

# Número de créditos para la aprobación de la tecnología y profesional
CREDITOS_TECNOLOGIA=97
CREDITOS_PROFESIONAL=65

# Configuración de la base de datos
DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Configuración de los servicios de cache, colas y sesiones
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Configuración de Memcached
MEMCACHED_HOST=127.0.0.1

# Configuración de Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Configuración del correo electrónico
MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Configuración de AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Configuración de Pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Configuración de Vite
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"